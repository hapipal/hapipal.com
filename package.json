{
  "name": "hapipal.com",
  "version": "1.0.1",
  "description": "Site for hapi pal",
  "author": "Devin Ivy <devin@bigroomstudios.com>",
  "license": "MIT",
  "main": "lib/index.js",
  "engines": {
    "node": ">=22"
  },
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "start": "node server",
    "test": "lab -a @hapi/code -L",
    "lint": "eslint .",
    "prebuild:css": "sass lib/public/css/main.scss lib/public/css/main.build.css --source-map --load-path=node_modules && postcss lib/public/css/main.build.css --replace --use autoprefixer --map",
    "build:css": "postcss lib/public/css/main.build.css -o lib/public/css/main.build.min.css --use cssnano --no-map",
    "prebuild:js": "browserify lib/public/js/main.js -o lib/public/js/main.build.js -d -t [ babelify --presets [ @babel/preset-env ] ]",
    "build:js": "uglifyjs lib/public/js/main.build.js -o lib/public/js/main.build.min.js",
    "build": "npm run build:css && npm run build:js"
  },
  "dependencies": {
    "@hapi/boom": "10.x.x",
    "@hapi/bounce": "3.x.x",
    "@hapi/glue": "9.x.x",
    "@hapi/hapi": "21.x.x",
    "@hapi/inert": "7.x.x",
    "@hapi/somever": "4.x.x",
    "@hapi/vision": "7.x.x",
    "@hapi/wreck": "18.x.x",
    "@hapipal/confidence": "6.x.x",
    "@hapipal/haute-couture": "4.x.x",
    "@hapipal/schmervice": "3.x.x",
    "@hapipal/toys": "4.x.x",
    "dotenv": "^16.6.1",
    "exiting": "6.x.x",
    "handlebars": "4.x.x",
    "joi": "17.x.x",
    "require-dir": "1.x.x"
  },
  "devDependencies": {
    "@babel/core": "7.x.x",
    "@babel/eslint-parser": "7.x.x",
    "@babel/preset-env": "7.x.x",
    "@hapi/code": "9.x.x",
    "@hapi/eslint-plugin": "6.x.x",
    "@hapi/lab": "25.x.x",
    "@hapipal/hpal": "3.x.x",
    "@hapipal/hpal-debug": "2.x.x",
    "@primer/css": "21.x.x",
    "autoprefixer": "10.x.x",
    "babelify": "10.x.x",
    "browser-sync": "3.x.x",
    "browserify": "17.x.x",
    "cssnano": "7.x.x",
    "eslint": "8.x.x",
    "hammerjs": "2.x.x",
    "postcss": "8.x.x",
    "postcss-cli": "11.x.x",
    "sass": "1.x.x",
    "scroll-into-view-if-needed": "3.x.x",
    "uglify-js": "3.x.x"
  }
}
